# Copy to .env for local development. NEVER commit .env.
# In production (ECS) these come from AWS SSM Parameter Store, not this file.

# --- Postgres (docker compose) ---
POSTGRES_USER=swarm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ops_db
DATABASE_URL=postgresql://swarm:change-me@localhost:5432/ops_db

# --- LLM provider (fill the one you use; tiers are set in config/models.yaml) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=

# --- AWS ---
AWS_REGION=ap-southeast-1
S3_BUCKET=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
